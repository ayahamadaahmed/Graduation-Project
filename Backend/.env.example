#Backend Environment Variables
APP_NAME=MedMind Booking Backend
APP_ENV=development
# APP_ENV=staging turns on the staging database guard (app/core/db_target.py):
# the backend refuses to start unless DB_NAME is set explicitly and is not
# the production database MedMind_Booking_DB.

DB_SERVER=ayahamada
# Set DB_NAME explicitly to the database you are approved to use BEFORE
# starting the backend (staging: MedMind_Audit_Final2). The placeholder below
# is not a real database, so an unedited copy cannot reach production.
# Check without connecting: python -m app.core.preflight
DB_NAME=<set-the-approved-database-name>
DB_DRIVER=ODBC Driver 18 for SQL Server

DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=

DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

NATIONAL_ID_HASH_KEY=
NATIONAL_ID_ENCRYPTION_KEY=

#Mcp
# Where the AI agent (backend process) and the smoke scripts reach the MCP
# server. The MCP server always binds 127.0.0.1:9000/mcp (mcp_server/server.py)
# and accepts only the hosts 127.0.0.1, localhost and host.docker.internal, so
# it must run beside the backend. MCP_HOST/MCP_PORT are not used.
MCP_URL=http://127.0.0.1:9000/mcp
MCP_BACKEND_BASE_URL=http://127.0.0.1:8001

MCP_REQUEST_TIMEOUT=20

# For MCP_URL above and every auth value below, a value set in the process
# environment wins over this file (agent/medmind/env_precedence.py); this file
# only fills values the environment does not set. Prefer one place per value.
# MCP authentication: two SEPARATE credentials, each at least 32 random
# characters. Generate your own; never reuse one value for both.
# Agent -> MCP: the AI agent (backend process) sends MCP_SERVER_TOKEN and the
# MCP server checks it. Set the same value for both processes.
MCP_SERVER_TOKEN=<generate-a-long-random-token-for-agent-to-mcp>
# Rotation overlap only (MCP server side): a second accepted inbound token.
# Leave empty except during a rotation (INTEGRATION_HANDOFF.md).
MCP_SERVER_TOKEN_NEXT=
# MCP -> Backend: must equal the mcp_server token in MEDMIND_SERVICE_CREDENTIALS.
MCP_BACKEND_SERVICE_TOKEN=<same-token-as-mcp_server-in-MEDMIND_SERVICE_CREDENTIALS>
# audit (transitional): calls without a token are still served and logged as
# mcp_service_auth_missing; they are NOT protected. enforce: they are rejected,
# and so is every call if MCP_SERVER_TOKEN is unset. A wrong token is always
# rejected. Switch to enforce only after the steps in INTEGRATION_HANDOFF.md.
MCP_AUTH_MODE=audit

#agent
AI_AGENT_MODEL_PROVIDER=openai
AI_AGENT_OPENAI_MODEL=gpt-4.1-mini
AI_AGENT_ANTHROPIC_MODEL=claude-haiku-4-5
AI_AGENT_TEMPERATURE=0


AI_RESPONSE_MODEL_PROVIDER=anthropic
AI_RESPONSE_ANTHROPIC_MODEL=claude-haiku-4-5
AI_RESPONSE_TEMPERATURE=0.3
#Agent API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1
PLANNER_MODEL=gpt-4.1-mini


PLANNER_MODEL=gpt-4.1
PLANNER_FALLBACK_MODEL=gpt-4.1
# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
