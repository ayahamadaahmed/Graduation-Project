N8N_WHATSAPP_WEBHOOK_SECRET=test-secret
N8N_WHATSAPP_WEBHOOK_URL=https://primary-production-c46b.up.railway.app/webhook-test/medmind-whatsapp


JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_MINUTES=15
# Failed staff logins per email before /auth/login answers 429
# (in memory, per backend worker).
STAFF_LOGIN_MAX_FAILURES=5
STAFF_LOGIN_WINDOW_MINUTES=15


VOICE_DIGIT_MAX_UTTERANCE_SECONDS=10.0
VOICE_HAMSA_DIGIT_SOFT_TIMEOUT_SECONDS=8.0
VOICE_DIGIT_INCOMPLETE_RETRY_SECONDS=3.0
VOICE_DIGIT_TURN_END_GRACE_SECONDS=0.3
VOICE_DEEPGRAM_STARTUP_BUFFER_SECONDS=3.0

QWEN_SERVICE_TIER=flex
# Best-effort Groq connection warm-up at backend startup (models.list, no
# completion). Only true/false. false skips just that call, e.g. for staging
# checks that must not contact Groq at startup; the planner is unchanged.
QWEN_PLANNER_WARMUP=true

RAG_PRIMARY_MODEL=qwen/qwen3.8-27b
RAG_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
RAG_PRIMARY_API_KEY=

RAG_FALLBACK_MODEL=gpt-4.1

RAG_PRIMARY_TIMEOUT_SECONDS=3
RAG_FALLBACK_TIMEOUT_SECONDS=8

RAG_DEFAULT_LIMIT=2
RAG_CONTEXT_CHARS=700
# Trusted server-side gateways allowed to call /api/v1/ai/* (chat, sessions,
# warmup) and POST /api/v1/diagnostics/attachments.
# Format: name=token@tenant-a,tenant-b;name2=token2@tenant-c
#   - each token unique, at least 32 random characters (never ship it to a
#     browser or mobile app)
#   - every allowed tenant ID listed explicitly; wildcards are rejected
# Unset or malformed => those routes reject every request (HTTP 503, fail closed).
# The booking/patient routes the MCP server calls accept only the mcp_server
# entry; list the same tenants the AI gateways serve. mcp_server is
# booking-only: the gateway routes (/ai/*, post-call, diagnostic attachments)
# refuse it with 403 SERVICE_NOT_ALLOWED.
MEDMIND_SERVICE_CREDENTIALS=voice_gateway=<generate-a-long-random-token>@<tenant-id>;mcp_server=<generate-another-long-random-token>@<tenant-id>
# Booking/patient routes (MCP -> Backend). audit (transitional): a request with
# no X-MedMind-Service-Token is still served and logged as
# booking_service_auth_missing; it is NOT protected. enforce: it is rejected
# (401, or 503 if MEDMIND_SERVICE_CREDENTIALS is unset). A wrong token is always
# rejected. Appointment confirmation always needs the mcp_server token or a
# staff token, in both modes.
# Rotation overlap only: one extra token for a service already listed above,
# same name and EXACTLY the same tenants, e.g. mcp_server=<new-token>@<tenant-id>.
# Leave empty except during a rotation; a bad value makes every service route
# answer 503 (fail closed).
MEDMIND_SERVICE_CREDENTIALS_NEXT=
BOOKING_SERVICE_AUTH_MODE=audit
# Idle minutes before a server-issued chat session expires.
AI_CHAT_SESSION_IDLE_MINUTES=60

# Voice gateway side: the voice_gateway token from MEDMIND_SERVICE_CREDENTIALS
# (sent on AI chat and post-call requests).
MEDMIND_SERVICE_TOKEN=<same-token-as-voice_gateway-above>

# Asterisk -> voice gateway media WebSocket (/asterisk/media).
# Asterisk must send these as channel variables in the MEDIA_START event:
#   MEDMIND_MEDIA_TOKEN = VOICE_MEDIA_SHARED_SECRET (at least 32 random characters)
#   MEDMIND_TENANT_ID   = the call's tenant (optional if VOICE_TENANT_ID is set)
# The tenant must be listed in VOICE_ALLOWED_TENANT_IDS (no wildcards). Missing or
# invalid secret/tenant/configuration => the call is closed (code 1008), fail closed.
VOICE_MEDIA_SHARED_SECRET=<generate-a-long-random-secret>
VOICE_ALLOWED_TENANT_IDS=<tenant-id>[,<tenant-id>...]
# Optional default tenant when Asterisk sends none; must also be allow-listed.
VOICE_TENANT_ID=
# Seconds an unauthenticated media connection may stay open before MEDIA_START.
VOICE_MEDIA_AUTH_TIMEOUT_SECONDS=10
