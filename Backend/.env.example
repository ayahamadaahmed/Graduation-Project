#Backend Environment Variables
APP_NAME=MedMind Booking Backend
APP_ENV=development

DB_SERVER=ayahamada
DB_NAME=MedMind_Booking_DB
DB_DRIVER=ODBC Driver 18 for SQL Server

DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=

DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

NATIONAL_ID_HASH_KEY=
NATIONAL_ID_ENCRYPTION_KEY=

#Mcp
MCP_BACKEND_BASE_URL=http://127.0.0.1:8001

MCP_REQUEST_TIMEOUT=20

#agent
AI_AGENT_MODEL_PROVIDER=openai
AI_AGENT_OPENAI_MODEL=gpt-4.1-mini
AI_AGENT_ANTHROPIC_MODEL=claude-haiku-4-5
AI_AGENT_TEMPERATURE=0


AI_RESPONSE_MODEL_PROVIDER=anthropic
AI_RESPONSE_ANTHROPIC_MODEL=claude-haiku-4-5
AI_RESPONSE_TEMPERATURE=0.3
#Agent API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1
PLANNER_MODEL=gpt-4.1-mini


PLANNER_MODEL=gpt-4.1
PLANNER_FALLBACK_MODEL=gpt-4.1
# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="hnu-healthcare-ai-dev"
LANGGRAPH_CHECKPOINTER_BACKEND='postgres'
LANGGRAPH_POSTGRES_URI='postgresql://langgraph:352004%D8%B4%D8%BA10@127.0.0.1:5432/medmind_langgraph'

# Never send healthcare content to LangSmith
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_HIDE_METADATA=true


#Telegram
TELEGRAM_BOT_TOKEN=

TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_WEBHOOK_URL=

SEMANTIC_ROUTER_DEVICE=cpu

DEEPGRAM_API_KEY=

# VOICE_TTS_PROVIDER=elevenlabs
VOICE_TTS_STREAMING=1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=YM0reNoesVeURI0Y7DBL

ELEVENLABS_MODEL_ID=eleven_multilingual_v2

ELEVENLABS_LANGUAGE_CODE=ar
STT_BENCHMARK_LOG_TRANSCRIPTS=false
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

VOICE_HAMSA_SHADOW=1
HAMSA_API_KEY=


# VOICE_TTS_PROVIDER=hamsa
VOICE_TTS_PROVIDER=hamsa
HAMSA_TTS_SPEAKER=Samir
HAMSA_TTS_DIALECT=egy
HAMSA_TTS_EXPRESSIVENESS=1

# QWEN PRIMARY PLANNER
GROQ_API_KEY=
QWEN_PLANNER_MODEL=qwen/qwen3.8-27b
QWEN_PLANNER_TIMEOUT=3
QWEN_PLANNER_MAX_TOKENS=160
QWEN_PRIMARY_BUDGET=1.5
QWEN_FALLBACK_HEDGE_DELAY=0.9
GPT_PLANNER_TIMEOUT=4


N8N_WHATSAPP_WEBHOOK_SECRET=test-secret
N8N_WHATSAPP_WEBHOOK_URL=https://primary-production-c46b.up.railway.app/webhook-test/medmind-whatsapp


JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_MINUTES=15


VOICE_DIGIT_MAX_UTTERANCE_SECONDS=10.0
VOICE_HAMSA_DIGIT_SOFT_TIMEOUT_SECONDS=8.0
VOICE_DIGIT_INCOMPLETE_RETRY_SECONDS=3.0
VOICE_DIGIT_TURN_END_GRACE_SECONDS=0.3
VOICE_DEEPGRAM_STARTUP_BUFFER_SECONDS=3.0

QWEN_SERVICE_TIER=flex

RAG_PRIMARY_MODEL=qwen/qwen3.8-27b
RAG_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
RAG_PRIMARY_API_KEY=

RAG_FALLBACK_MODEL=gpt-4.1

RAG_PRIMARY_TIMEOUT_SECONDS=3
RAG_FALLBACK_TIMEOUT_SECONDS=8

RAG_DEFAULT_LIMIT=2
RAG_CONTEXT_CHARS=700