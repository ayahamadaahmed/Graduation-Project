APP_NAME=MedMind Booking Backend
APP_ENV=development

# Example default SQL Server instance:
DB_SERVER=localhost
DB_NAME=MedMind_Booking_DB
DB_DRIVER=ODBC Driver 18 for SQL Server

# Windows Authentication
DB_TRUSTED_CONNECTION=true

# Used only when DB_TRUSTED_CONNECTION=false
DB_USER=
DB_PASSWORD=

DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
